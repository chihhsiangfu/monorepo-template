{
  "name": "monorepo-template",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "check-lint": "ultracite check",
    "fix-lint": "ultracite fix",
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "turbo test:e2e",
    "test:e2e:ui": "turbo test:e2e:ui",
    "delete-node-modules": " rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tsx": "catalog:",
    "turbo": "^2.10.0",
    "typescript": "catalog:",
    "ultracite": "7.5.6",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm dlx ultracite fix"
    ]
  },
  "packageManager": "pnpm@11.9.0"
}
